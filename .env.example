# ==============================================================================
# GovFleet Environment Configuration (.env.example)
# Copy this file to .env in backend/ and simulator/ as needed
# ==============================================================================

# MQTT Broker (Eclipse Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=govfleet/vehicles/+/telemetry

# Apache Kafka Broker
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=govfleet-ingestion-service
KAFKA_GROUP_ID=govfleet-telemetry-consumer-group
KAFKA_TOPIC_LOCATIONS=bus-locations

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_GEO_KEY=govfleet:active_buses:geo
REDIS_HASH_PREFIX=govfleet:bus:

# MongoDB (Historical & Route Store)
MONGO_URI=mongodb://localhost:27017/govfleet
MONGO_DB_NAME=govfleet

# Backend API & WebSocket Server
PORT=5000
WS_PORT=5000
NODE_ENV=development

# Frontend Configuration
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here
VITE_BACKEND_WS_URL=ws://localhost:5000
VITE_BACKEND_API_URL=http://localhost:5000
